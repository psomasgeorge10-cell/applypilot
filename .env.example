# ---------------------------------------------------------------------------
# Copy to .env.local and adjust. With nothing but ANTHROPIC_API_KEY set, the
# app runs on an embedded PostgreSQL (PGlite) stored in ./.pglite.
# ---------------------------------------------------------------------------

# Required for resume parsing, job scoring, cover letters and form answers.
# ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5).
# ANTHROPIC_MODEL=claude-opus-5

# Submit applications for real. Leave unset (dry run) until you have watched a
# few applications get filled in correctly - in dry-run mode every field is
# filled but the final "Submit" is never clicked.
# APPLY_LIVE=true

# Chromium used by the auto-apply submitter. Examples:
#   macOS:  /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:  /usr/bin/chromium
# CHROMIUM_PATH=

# Maximum postings scored per pipeline run (bounds cost and run time).
# PIPELINE_MAX_SCORED=40

# How often `npm run worker` runs every user's pipeline.
# WORKER_INTERVAL_MINUTES=60

# Point at a real PostgreSQL server instead of the embedded database.
# Required when running the worker alongside the web app.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/applypilot
# DATABASE_AUTO_MIGRATE=false

# Secret used to sign session JWTs. REQUIRED in production.
# Generate one with: openssl rand -base64 32
# AUTH_SECRET=

# Password for the demo account created by `npm run db:setup`.
# SEED_DEMO_PASSWORD=password123
